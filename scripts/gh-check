#!/usr/bin/env bash
# Read-only: what each agent's GitHub identity is and reaches (login, installations, repos, permissions,
# token expiry), without printing a token. Changes nothing.
#
#   gh-check            all four identities
#   gh-check malek
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m agent_gh check "$@"
