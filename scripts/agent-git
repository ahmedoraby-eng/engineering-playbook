#!/usr/bin/env bash
# Run git as a named AI agent, so every commit says which agent made it.
#
#   agent-git <agent> <git arguments...>
#   agent-git malek commit -m "DFP-123: fix the plan total"
#
# Sets author and committer to "<Name> (Basita AI) <name@domain>" for this one command only
# (no shared git config, so parallel sessions in one checkout don't clash). An agent with a GitHub App
# (config/github-identities.json) uses the App's bot address instead, <bot id>+basita-<agent>[bot]@users.noreply.github.com,
# so GitHub links the commit to the bot; AGENT_GIT_LEGACY_EMAIL=1 goes back to name@domain.
# `agent-git <agent> push ...` pushes with that App's 1-hour token (never to main, never forced or
# deleting; see src/agent_gh/policy.py), not with the Mac's own GitHub login. On `commit` it
# also adds the trailers that the agent-attribution check reads:
#   Agent: Malek
#   Requested-by: <the human the agent works for>
#   Agent-Model: <model>   (only when AGENT_MODEL is set)
#
# Environment: BASITA_AGENT_DOMAIN (default basitasolutions.com),
#              BASITA_REQUESTED_BY (default "Ahmed Oraby <ahmed.oraby@icloud.com>"), AGENT_MODEL.
set -euo pipefail

AGENTS="talia malek salma sherif haya adam nora maya yousef basel"

if [ $# -lt 2 ]; then
  echo "usage: agent-git <agent> <git arguments...>   agents: $AGENTS" >&2
  exit 2
fi

agent=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
shift
case " $AGENTS " in
  *" $agent "*) ;;
  *) echo "agent-git: unknown agent '$agent' (known: $AGENTS)" >&2; exit 2 ;;
esac

display="$(printf '%s' "${agent:0:1}" | tr '[:lower:]' '[:upper:]')${agent:1}"
name="$display (Basita AI)"
email="$agent@${BASITA_AGENT_DOMAIN:-basitasolutions.com}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
agent_gh() { PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}" python3 -m agent_gh "$@"; }

if [ "$1" = "push" ]; then
  shift
  agent_gh push "$agent" "$@"
  exit $?
fi
# A push hidden behind git options (agent-git malek -C x push) would use the Mac's own login.
if [ "${1#-}" != "$1" ]; then
  for arg in "$@"; do
    if [ "$arg" = "push" ]; then
      echo "agent-git: put push first (cd into the repository): agent-git $agent push ..." >&2
      exit 2
    fi
  done
fi
if [ -z "${AGENT_GIT_LEGACY_EMAIL:-}" ] && bot="$(agent_gh bot-email "$agent" 2>/dev/null)" && [ -n "$bot" ]; then
  email="$bot"
fi

if [ "$1" = "commit" ]; then
  shift
  trailers=(--trailer "Agent: $display" --trailer "Requested-by: ${BASITA_REQUESTED_BY:-Ahmed Oraby <ahmed.oraby@icloud.com>}")
  if [ -n "${AGENT_MODEL:-}" ]; then
    trailers+=(--trailer "Agent-Model: $AGENT_MODEL")
  fi
  set -- commit "${trailers[@]}" "$@"
fi

exec git -c "user.name=$name" -c "user.email=$email" "$@"
